# App bind address. Loopback is enough for a tunnel on the same machine.
HOST=127.0.0.1
PORT=3000

# Public HTTPS MCP address, including /mcp; leave empty for local-only use.
# Example: https://kando.example.org/mcp
# The public host is allowed automatically. Update this if your tunnel URL changes.
MCP_PUBLIC_URL=

# Required when MCP_PUBLIC_URL is set: a long, random token.
# Client header: Authorization: Bearer <token>
MCP_TOKEN=

# Additional allowed hostnames, without scheme or port. Not a list of client IPs.
# If the tunnel rewrites Host, add the internal hostname here.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
