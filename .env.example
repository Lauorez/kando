# App-Bind-Adresse. Für einen Tunnel auf demselben Rechner reicht Loopback.
HOST=127.0.0.1
PORT=3000

# Öffentliche MCP-Adresse des Tunnels, inklusive /mcp; leer für rein lokalen Betrieb.
# Beispiel: https://kando.example.org/mcp
# Der öffentliche Host wird automatisch erlaubt. Bei wechselnder Tunnel-URL anpassen.
MCP_PUBLIC_URL=

# Bei gesetzter MCP_PUBLIC_URL erforderlich: ein langer, zufälliger Token.
# Client-Header: Authorization: Bearer <Token>
MCP_TOKEN=

# Zusätzliche erlaubte Hostnamen, ohne Schema/Port. Keine Client-IP-Liste.
# Bei einem Tunnel mit internem Host-Rewrite den internen Host ergänzen.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
